property pos, pSpeed, pendpos, plifetime, puffin, pname, pid, pwhogotit
global gmem, goody

on new me, nspos, nepos, nam, nid, nteam
  [  0] getparam 4 .............................. <nid>
  [  2] setprop 305 ............................. pid = nid
  [  5] getparam 3 .............................. <nam>
  [  7] setprop 301 ............................. pname = nam
  [ 10] getparam 1 .............................. <nspos>
  [ 12] setprop 105 ............................. pos = nspos
  [ 14] getparam 2 .............................. <nepos>
  [ 16] setprop 307 ............................. pendpos = nepos
  [ 19] getprop 307 ............................. <pendpos>
  [ 22] getprop 105 ............................. <pos>
  [ 24] sub ..................................... <pendpos - pos>
  [ 25] setprop 725 ............................. pSpeed = pendpos - pos
  [ 28] getprop 725 ............................. <pSpeed>
  [ 31] pusharglistnoret 1 ...................... <pSpeed>
  [ 33] objcall 693 ............................. pSpeed.normalize()
  [ 36] getprop 725 ............................. <pSpeed>
  [ 39] getglobal 83 ............................ <goody>
  [ 41] getobjprop 160 .......................... <goody.bsp>
  [ 43] mul ..................................... <pSpeed * goody.bsp>
  [ 44] pushcons 0 .............................. <2.29999999999999982>
  [ 46] mul ..................................... <pSpeed * goody.bsp * 2.29999999999999982>
  [ 47] setprop 725 ............................. pSpeed = pSpeed * goody.bsp * 2.29999999999999982
  [ 50] pushint8 1 .............................. <1>
  [ 52] setprop 1113 ............................ puffin = 1
  [ 55] pushint16 1000 .......................... <1000>
  [ 58] setprop 1060 ............................ plifetime = 1000
  [ 61] getprop 105 ............................. <pos>
  [ 63] pushcons 1 .............................. <"resonicblast">
  [ 65] pushint8 7 .............................. <7>
  [ 67] pusharglistnoret 3 ...................... <pos, "resonicblast", 7>
  [ 69] extcall 10 .............................. playsound(pos, "resonicblast", 7)
  [ 71] getmovieprop 71 ......................... <the actorList>
  [ 73] getparam 0 .............................. <me>
  [ 75] pusharglistnoret 2 ...................... <the actorList, me>
  [ 77] objcall 154 ............................. (the actorList).add(me)
  [ 79] ret
end

on stepFrame me
  [  0] pusharglist 0 ........................... <>
  [  2] extcall 11 .............................. <checkgoody()>
  [  4] not ..................................... <not checkgoody()>
  [  5] jmpifz [ 17] ............................ if not checkgoody() then / else
  [  8] getparam 0 .............................. <me>
  [ 10] pusharglistnoret 1 ...................... <me>
  [ 12] localcall 3 ............................. Remove(me)
  [ 14] jmp [107]
  [ 17] getprop 1060 ............................ <plifetime>
  [ 20] pushint8 1 .............................. <1>
  [ 22] sub ..................................... <plifetime - 1>
  [ 23] setprop 1060 ............................ plifetime = plifetime - 1
  [ 26] getparam 0 .............................. <me>
  [ 28] getprop 105 ............................. <pos>
  [ 30] pusharglistnoret 2 ...................... <me, pos>
  [ 32] localcall 2 ............................. puff(me, pos)
  [ 34] getprop 105 ............................. <pos>
  [ 36] getprop 725 ............................. <pSpeed>
  [ 39] add ..................................... <pos + pSpeed>
  [ 40] setprop 105 ............................. pos = pos + pSpeed
  [ 42] getprop 105 ............................. <pos>
  [ 44] getprop 307 ............................. <pendpos>
  [ 47] pusharglist 2 ........................... <pos, pendpos>
  [ 49] objcall 98 .............................. <pos.distanceTo(pendpos)>
  [ 51] getprop 725 ............................. <pSpeed>
  [ 54] getobjprop 171 .......................... <pSpeed.magnitude>
  [ 56] lt ...................................... <pos.distanceTo(pendpos) < pSpeed.magnitude>
  [ 57] jmpifz [ 93] ............................ if pos.distanceTo(pendpos) < pSpeed.magnitude then
  [ 60] getprop 307 ............................. <pendpos>
  [ 63] setprop 105 ............................. pos = pendpos
  [ 65] pushcons 2 .............................. <"bangs">
  [ 67] pusharglist 1 ........................... <"bangs">
  [ 69] extcall 303 ............................. <script("bangs")>
  [ 72] getprop 307 ............................. <pendpos>
  [ 75] pushcons 3 .............................. <"sonicgun">
  [ 77] getprop 301 ............................. <pname>
  [ 80] pusharglist 4 ........................... <script("bangs"), pendpos, "sonicgun", pname>
  [ 82] objcall 265 ............................. <script("bangs").new(pendpos, "sonicgun", pname)>
  [ 85] setlocal 0 .............................. bang = script("bangs").new(pendpos, "sonicgun", pname)
  [ 87] getparam 0 .............................. <me>
  [ 89] pusharglistnoret 1 ...................... <me>
  [ 91] localcall 3 ............................. Remove(me)
  [ 93] getprop 1060 ............................ <plifetime>
  [ 96] pushzero ................................ <0>
  [ 97] lt ...................................... <plifetime < 0>
  [ 98] jmpifz [107] ............................ if plifetime < 0 then
  [101] getparam 0 .............................. <me>
  [103] pusharglistnoret 1 ...................... <me>
  [105] localcall 3 ............................. Remove(me)
  [107] ret
end

on puff me, pos
  [  0] getprop 1113 ............................ <puffin>
  [  3] not ..................................... <not puffin>
  [  4] setprop 1113 ............................ puffin = not puffin
  [  7] getprop 1113 ............................ <puffin>
  [ 10] pushint8 1 .............................. <1>
  [ 12] eq ...................................... <puffin = 1>
  [ 13] jmpifz [ 36] ............................ if puffin = 1 then
  [ 16] pushcons 4 .............................. <"puff">
  [ 18] pushcons 5 .............................. <"parents">
  [ 20] pusharglist 2 ........................... <"puff", "parents">
  [ 22] extcall 303 ............................. <script("puff", "parents")>
  [ 25] getprop 105 ............................. <pos>
  [ 27] pushcons 6 .............................. <"impulse">
  [ 29] pusharglist 3 ........................... <script("puff", "parents"), pos, "impulse">
  [ 31] objcall 265 ............................. <script("puff", "parents").new(pos, "impulse")>
  [ 34] setlocal 0 .............................. puff = script("puff", "parents").new(pos, "impulse")
  [ 36] ret
end

on Remove me
  [  0] getmovieprop 71 ......................... <the actorList>
  [  2] getparam 0 .............................. <me>
  [  4] pusharglistnoret 2 ...................... <the actorList, me>
  [  6] objcall 227 ............................. (the actorList).deleteOne(me)
  [  8] ret
end
