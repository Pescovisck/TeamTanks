property pspr, pmem, scrb, mousein
global mus, gmusmode, gmaxusers, gmygroup, gScreenRect, gScreenDepth

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getobjprop 944 .......................... <me.spriteNum>
  [  5] pusharglist 1 ........................... <me.spriteNum>
  [  7] extcall 282 ............................. <sprite(me.spriteNum)>
  [ 10] setprop 1117 ............................ pspr = sprite(me.spriteNum)
  [ 13] getprop 1117 ............................ <pspr>
  [ 16] getobjprop 52 ........................... <pspr.member>
  [ 18] setprop 1230 ............................ pmem = pspr.member
  [ 21] getprop 1117 ............................ <pspr>
  [ 24] getobjprop 1236 ......................... <pspr.right>
  [ 27] setprop 1235 ............................ scrb = pspr.right
  [ 30] getprop 1117 ............................ <pspr>
  [ 33] pushzero ................................ <0>
  [ 34] setobjprop 1226 ......................... pspr.visible = 0
  [ 37] gettoplevelprop 195 ..................... <_player>
  [ 39] pushint8 1 .............................. <1>
  [ 41] inv ..................................... <-1>
  [ 42] pusharglistnoret 2 ...................... <_player, -1>
  [ 44] objcall 597 ............................. _player.cursor(-1)
  [ 47] ret
end

on exitFrame me
  [  0] getprop 1237 ............................ <mousein>
  [  3] pushint8 1 .............................. <1>
  [  5] eq ...................................... <mousein = 1>
  [  6] jmpifz [ 95] ............................ if mousein = 1 then
  [  9] getprop 1117 ............................ <pspr>
  [ 12] getmovieprop 546 ........................ <the mouseLoc>
  [ 15] pusharglist 2 ........................... <pspr, the mouseLoc>
  [ 17] objcall 1238 ............................ <pspr.pointToLine(the mouseLoc)>
  [ 20] setlocal 0 .............................. lineNum = pspr.pointToLine(the mouseLoc)
  [ 22] getprop 1230 ............................ <pmem>
  [ 25] pushint16 255 ........................... <255>
  [ 28] pushint16 255 ........................... <255>
  [ 31] pushint16 255 ........................... <255>
  [ 34] pusharglist 3 ........................... <255, 255, 255>
  [ 36] extcall 115 ............................. <rgb(255, 255, 255)>
  [ 38] setobjprop 409 .......................... pmem.color = rgb(255, 255, 255)
  [ 41] getlocal 0 .............................. <lineNum>
  [ 43] pushzero ................................ <0>
  [ 44] gt ...................................... <lineNum > 0>
  [ 45] jmpifz [ 95] ............................ if lineNum > 0 then
  [ 48] getprop 1230 ............................ <pmem>
  [ 51] pushsymb 408 ............................ <#line>
  [ 54] getlocal 0 .............................. <lineNum>
  [ 56] pusharglist 3 ........................... <pmem, #line, lineNum>
  [ 58] objcall 122 ............................. <pmem.line[lineNum]>
  [ 60] pusharglist 1 ........................... <pmem.line[lineNum]>
  [ 62] extcall 55 .............................. <voidp(pmem.line[lineNum])>
  [ 64] not ..................................... <not voidp(pmem.line[lineNum])>
  [ 65] jmpifz [ 95] ............................ if not voidp(pmem.line[lineNum]) then
  [ 68] getprop 1230 ............................ <pmem>
  [ 71] pushsymb 408 ............................ <#line>
  [ 74] getlocal 0 .............................. <lineNum>
  [ 76] pusharglist 3 ........................... <pmem, #line, lineNum>
  [ 78] objcall 650 ............................. <pmem.line[lineNum]>
  [ 81] pushint16 255 ........................... <255>
  [ 84] pushint16 255 ........................... <255>
  [ 87] pushzero ................................ <0>
  [ 88] pusharglist 3 ........................... <255, 255, 0>
  [ 90] extcall 115 ............................. <rgb(255, 255, 0)>
  [ 92] setobjprop 409 .......................... pmem.line[lineNum].color = rgb(255, 255, 0)
  [ 95] ret
end

on mouseDown me
  [  0] getmovieprop 546 ........................ <the mouseLoc>
  [  3] getobjprop 674 .......................... <(the mouseLoc).locH>
  [  6] getprop 1235 ............................ <scrb>
  [  9] lt ...................................... <(the mouseLoc).locH < scrb>
  [ 10] jmpifz [ 98] ............................ if (the mouseLoc).locH < scrb then
  [ 13] getprop 1117 ............................ <pspr>
  [ 16] getmovieprop 546 ........................ <the mouseLoc>
  [ 19] pusharglist 2 ........................... <pspr, the mouseLoc>
  [ 21] objcall 1238 ............................ <pspr.pointToLine(the mouseLoc)>
  [ 24] setlocal 0 .............................. lineNum = pspr.pointToLine(the mouseLoc)
  [ 26] getprop 1117 ............................ <pspr>
  [ 29] getchainedprop 52 ....................... <pspr.member>
  [ 31] pushsymb 408 ............................ <#line>
  [ 34] getlocal 0 .............................. <lineNum>
  [ 36] pusharglist 3 ........................... <pspr.member, #line, lineNum>
  [ 38] objcall 122 ............................. <pspr.member.line[lineNum]>
  [ 40] setlocal 1 .............................. tmp = pspr.member.line[lineNum]
  [ 42] getlocal 1 .............................. <tmp>
  [ 44] pushsymb 1240 ........................... <#word>
  [ 47] pushint8 2 .............................. <2>
  [ 49] pusharglist 3 ........................... <tmp, #word, 2>
  [ 51] objcall 122 ............................. <tmp.word[2]>
  [ 53] pushcons 0 .............................. <"full">
  [ 55] eq ...................................... <tmp.word[2] = "full">
  [ 56] jmpifz [ 68] ............................ if tmp.word[2] = "full" then / else
  [ 59] pushcons 1 .............................. <"Level full, please choose another">
  [ 61] pusharglistnoret 1 ...................... <"Level full, please choose another">
  [ 63] extcall 121 ............................. alert("Level full, please choose another")
  [ 65] jmp [ 98]
  [ 68] getlocal 1 .............................. <tmp>
  [ 70] pushsymb 1240 ........................... <#word>
  [ 73] pushint8 1 .............................. <1>
  [ 75] pusharglist 3 ........................... <tmp, #word, 1>
  [ 77] objcall 122 ............................. <tmp.word[1]>
  [ 79] setglobal 262 ........................... gmygroup = tmp.word[1]
  [ 82] getglobal 70 ............................ <mus>
  [ 84] pushcons 2 .............................. <"system.group.join">
  [ 86] pushcons 3 .............................. <EMPTY>
  [ 88] getglobal 262 ........................... <gmygroup>
  [ 91] pusharglist 4 ........................... <mus, "system.group.join", EMPTY, gmygroup>
  [ 93] objcall 291 ............................. <mus.sendNetMessage("system.group.join", EMPTY, gmygroup)>
  [ 96] setlocal 2 .............................. errCode = mus.sendNetMessage("system.group.join", EMPTY, gmygroup)
  [ 98] pushint8 1 .............................. <1>
  [100] inv ..................................... <-1>
  [101] pusharglistnoret 1 ...................... <-1>
  [103] extcall 597 ............................. cursor(-1)
  [106] ret
end

on mouseEnter me
  [  0] pushint8 1 .............................. <1>
  [  2] setprop 1237 ............................ mousein = 1
  [  5] pushint16 280 ........................... <280>
  [  8] pusharglistnoret 1 ...................... <280>
  [ 10] extcall 597 ............................. cursor(280)
  [ 13] ret
end

on mouseLeave me
  [  0] pushzero ................................ <0>
  [  1] setprop 1237 ............................ mousein = 0
  [  4] getprop 1230 ............................ <pmem>
  [  7] pushint16 255 ........................... <255>
  [ 10] pushint16 255 ........................... <255>
  [ 13] pushint16 255 ........................... <255>
  [ 16] pusharglist 3 ........................... <255, 255, 255>
  [ 18] extcall 115 ............................. <rgb(255, 255, 255)>
  [ 20] setobjprop 409 .......................... pmem.color = rgb(255, 255, 255)
  [ 23] pushint8 1 .............................. <1>
  [ 25] inv ..................................... <-1>
  [ 26] pusharglistnoret 1 ...................... <-1>
  [ 28] extcall 597 ............................. cursor(-1)
  [ 31] ret
end
