property pActive
global goody

on new me
  [  0] pushzero ................................ <0>
  [  1] setprop 777 ............................. pActive = 0
  [  4] getmovieprop 71 ......................... <the actorList>
  [  6] getparam 0 .............................. <me>
  [  8] pusharglistnoret 2 ...................... <the actorList, me>
  [ 10] objcall 154 ............................. (the actorList).add(me)
  [ 12] getparam 0 .............................. <me>
  [ 14] pusharglistnoret 1 ...................... <me>
  [ 16] extcall 40 .............................. return me
  [ 18] ret
end

on stepFrame me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 899 .......................... <the mouseDown>
  [  5] pusharglist 0 ........................... <>
  [  7] thebuiltin 900 .......................... <the controlDown>
  [ 10] or ...................................... <the mouseDown or the controlDown>
  [ 11] jmpifz [ 63] ............................ if the mouseDown or the controlDown then / else
  [ 14] getprop 777 ............................. <pActive>
  [ 17] pushzero ................................ <0>
  [ 18] eq ...................................... <pActive = 0>
  [ 19] jmpifz [ 53] ............................ if pActive = 0 then
  [ 22] pushint8 8 .............................. <8>
  [ 24] pusharglist 1 ........................... <8>
  [ 26] extcall 101 ............................. <sound(8)>
  [ 28] pushsymb 52 ............................. <#member>
  [ 30] pushcons 0 .............................. <"respeed">
  [ 32] pusharglist 1 ........................... <"respeed">
  [ 34] extcall 52 .............................. <member("respeed")>
  [ 36] pushsymb 643 ............................ <#rateShift>
  [ 39] pushint8 1 .............................. <1>
  [ 41] pusharglist 4 ........................... <[#member: member("respeed"), #rateShift: 1]>
  [ 43] pushproplist ............................ <[#member: member("respeed"), #rateShift: 1]>
  [ 44] pusharglistnoret 2 ...................... <sound(8), [#member: member("respeed"), #rateShift: 1]>
  [ 46] objcall 103 ............................. sound(8).play([#member: member("respeed"), #rateShift: 1])
  [ 48] pushint8 1 .............................. <1>
  [ 50] setprop 777 ............................. pActive = 1
  [ 53] getglobal 83 ............................ <goody>
  [ 55] pushint8 1 .............................. <1>
  [ 57] setobjprop 578 .......................... goody.pspeedo = 1
  [ 60] jmp [ 84]
  [ 63] pushint8 8 .............................. <8>
  [ 65] pusharglist 1 ........................... <8>
  [ 67] extcall 101 ............................. <sound(8)>
  [ 69] pusharglistnoret 1 ...................... <sound(8)>
  [ 71] objcall 1301 ............................ sound(8).stop()
  [ 74] getglobal 83 ............................ <goody>
  [ 76] pushzero ................................ <0>
  [ 77] setobjprop 578 .......................... goody.pspeedo = 0
  [ 80] pushzero ................................ <0>
  [ 81] setprop 777 ............................. pActive = 0
  [ 84] getglobal 83 ............................ <goody>
  [ 86] getobjprop 315 .......................... <goody.pweapon>
  [ 89] pushsymb 340 ............................ <#speed>
  [ 92] nteq .................................... <goody.pweapon <> #speed>
  [ 93] getglobal 83 ............................ <goody>
  [ 95] getobjprop 358 .......................... <goody.pstate>
  [ 98] pushcons 1 .............................. <"repos">
  [100] eq ...................................... <goody.pstate = "repos">
  [101] or ...................................... <(goody.pweapon <> #speed) or (goody.pstate = "repos")>
  [102] getglobal 83 ............................ <goody>
  [104] getobjprop 358 .......................... <goody.pstate>
  [107] pushcons 2 .............................. <"end">
  [109] eq ...................................... <goody.pstate = "end">
  [110] or ...................................... <(goody.pweapon <> #speed) or (goody.pstate = "repos") or (goody.pstate = "end")>
  [111] jmpifz [120] ............................ if (goody.pweapon <> #speed) or (goody.pstate = "repos") or (goody.pstate = "end") then
  [114] getparam 0 .............................. <me>
  [116] pusharglistnoret 1 ...................... <me>
  [118] localcall 2 ............................. die(me)
  [120] ret
end

on die me
  [  0] pushint8 8 .............................. <8>
  [  2] pusharglist 1 ........................... <8>
  [  4] extcall 101 ............................. <sound(8)>
  [  6] pusharglistnoret 1 ...................... <sound(8)>
  [  8] objcall 1301 ............................ sound(8).stop()
  [ 11] getglobal 83 ............................ <goody>
  [ 13] pushzero ................................ <0>
  [ 14] setobjprop 578 .......................... goody.pspeedo = 0
  [ 17] getglobal 83 ............................ <goody>
  [ 19] getchainedprop 586 ...................... <goody.weaponry>
  [ 22] pusharglist 0 ........................... <>
  [ 24] extcall 66 .............................. <VOID>
  [ 26] setobjprop 725 .......................... goody.weaponry.pSpeed = VOID
  [ 29] getmovieprop 71 ......................... <the actorList>
  [ 31] getparam 0 .............................. <me>
  [ 33] pusharglistnoret 2 ...................... <the actorList, me>
  [ 35] objcall 227 ............................. (the actorList).deleteOne(me)
  [ 37] ret
end
